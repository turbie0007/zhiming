{
  "name": "zhiming",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "知命 · 四柱八字排盤",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync",
    "sync:ios": "npm run build:web && cap sync ios",
    "sync:android": "npm run build:web && cap sync android",
    "build:android": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "release:android": "node scripts/release.mjs android",
    "release:ios": "node scripts/release.mjs ios",
    "test:release": "node --test scripts/release.test.mjs",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "assets": "capacitor-assets generate --assetPath resources --ios --android --iconBackgroundColor '#A6362B' --iconBackgroundColorDark '#14120E' --splashBackgroundColor '#F4EFE4' --splashBackgroundColorDark '#14120E'",
    "serve": "python3 -m http.server 4173"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "typescript": "^7.0.2"
  }
}
